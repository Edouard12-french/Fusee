# Clé API Anthropic (https://platform.claude.com) — obligatoire
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé par les agents
FUSEE_MODEL=claude-opus-5-5
# Effort de réflexion : low | medium | high | xhigh | max
FUSEE_EFFORT=medium

# Plafond de dépense API par jour (USD). Les agents s'arrêtent quand il est atteint.
DAILY_BUDGET_USD=10

# Multiplicateur des intervalles entre deux cycles (2 = deux fois moins souvent, donc moins cher)
INTERVAL_MULTIPLIER=1

# Autoriser les agents à exécuter le code Python qu'ils écrivent (dans workspace/, timeout 60 s)
ALLOW_CODE_EXEC=true

# Nombre d'agents pouvant travailler en même temps
MAX_PARALLEL_AGENTS=2

# Port du tableau de bord
PORT=8000

# --- Notifications sur ton téléphone (gratuit) ---
# 1. Installe l'app « ntfy » (Android / iPhone)
# 2. Abonne-toi à un nom de sujet secret et difficile à deviner, ex. fusee-edouard-8f3k29x
# 3. Mets ce même nom ici
NTFY_TOPIC=
# Lien ouvert quand tu touches la notification (adresse du tableau de bord)
DASHBOARD_URL=http://localhost:8000

# Mot de passe du tableau de bord (fortement conseillé : sinon n'importe qui sur ton Wi-Fi peut valider à ta place)
DASHBOARD_PASSWORD=

# --- Service client par e-mail (agent Iris) — optionnel ---
# Utilise une adresse dédiée au business (ex. Gmail avec un « mot de passe d'application »)
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SIGNATURE=L'équipe support
EMAIL_POLL_SECONDS=120

# Ouvre automatiquement l'application au démarrage
OPEN_BROWSER=true

# --- Mise en ligne des sites (Netlify, gratuit) ---
# netlify.com → User settings → Applications → Personal access tokens → New access token
NETLIFY_TOKEN=

# --- Paiements (Stripe) : l'argent des ventes arrive sur TON compte Stripe ---
# dashboard.stripe.com → Développeurs → Clés API → Clé secrète (commence par sk_live_ ; sk_test_ pour essayer)
STRIPE_SECRET_KEY=

# --- Chat en direct sur les sites mis en ligne ---
# Adresse publique de Fusée (voir README : Tailscale Funnel ou Cloudflare Tunnel). Vide = contact par e-mail.
PUBLIC_URL=
